<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/floatingRootLayout"
    android:layout_width="330dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Bar: Drag Handle, Brand, Profitability Badge, Collapse & Close -->
    <LinearLayout
        android:id="@+id/headerDragBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/ivDragHandle"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/overlay_recenter"
            android:src="@drawable/ic_drag_handle" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="AETOS HUD"
            android:textColor="@color/accent_cyan_info"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvEngineSourceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_card_dark"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="NODE TREE"
            android:textColor="@color/accent_cyan_info"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProfitabilityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_profit"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="PROFITABLE"
            android:textColor="@color/accent_driver_green"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivCollapseOverlay"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Minimize HUD"
            android:padding="3dp"
            android:src="@drawable/ic_drag_handle" />

        <ImageView
            android:id="@+id/ivCloseOverlay"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/overlay_close"
            android:padding="3dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Autonomous AI Mutation Auto-Patch Banner -->
    <LinearLayout
        android:id="@+id/bannerAiMutation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_metric_box_pickup"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAiMutationIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧠"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAiMutationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="AI Mutation Auto-Adapted"
                android:textColor="@color/accent_cyan_info"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvAiMutationDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Uber UI layout shift detected (98% Conf)"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnDismissMutation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_profit"
            android:fontFamily="sans-serif-bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="SYNC OK"
            android:textColor="@color/accent_driver_green"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Content Section (Can be collapsed / expanded) -->
    <LinearLayout
        android:id="@+id/metricsContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Critical Separation: Pickup vs Trip isolated metric boxes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Isolated Box 1: Pickup Distance & ETA (Driver Overhead) -->
            <LinearLayout
                android:id="@+id/boxPickupMetrics"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_box_pickup"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@string/metric_pickup_distance"
                        android:src="@drawable/ic_navigation_pickup" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="PICKUP (Overhead)"
                        android:textColor="@color/accent_cyan_info"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPickupDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-black"
                    android:text="1.2 km"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvPickupTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="3 min away"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Isolated Box 2: Trip Distance & Duration (Passenger Journey) -->
            <LinearLayout
                android:id="@+id/boxTripMetrics"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_box_trip"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@string/metric_trip_distance"
                        android:src="@drawable/ic_route_trip" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="TRIP (Billed)"
                        android:textColor="@color/accent_driver_green"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTripDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-black"
                    android:text="8.5 km"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvTripDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="22 mins"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Fare Calculation & App Comparison Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/overlay_fare_title"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvRatePerKm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Trip Rate: $2.80/km"
                    android:textColor="@color/accent_cyan_info"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <!-- Calculated True Fare -->
                <TextView
                    android:id="@+id/tvCalculatedFare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="$28.50"
                    android:textColor="@color/accent_driver_green"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAppOfferFare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Offer: $32.00"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvFareDifference"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="+ $3.50 (Driver Surplus)"
                        android:textColor="@color/accent_driver_green"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Driver Net Earnings row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNetDriverProfit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="Driver Net: $25.60"
                    android:textColor="@color/accent_amber"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvTotalDistanceSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Total Op: 9.7 km"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick HUD Actions: OCR Scan & Simulate Ride Alert -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnScanOcr"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_box_pickup"
                android:gravity="center"
                android:text="⚡ OCR Scan"
                android:textColor="@color/accent_cyan_info"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSimulateNext"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_driver_green"
                android:gravity="center"
                android:text="@string/overlay_simulate"
                android:textColor="@color/bg_slate_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAppSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:text="Uber / InDrive Telemetry Active"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
